{
  "name": "futforge-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:leaks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/leaks/*.test.mjs src/lib/leaks/ingestion/*.test.mjs",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/auth-recovery.test.mjs src/components/auth-recovery-ui.test.mjs src/components/clerk-password-recovery.test.mjs src/components/controlled-clerk-login.test.mjs",
    "test:admin": "node --test src/lib/admin-username.test.mjs",
    "test:register": "node --test src/lib/register-username.test.mjs src/lib/auth/controlled-signup.test.mjs",
    "test:turso-auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/auth/turso-identity-repository.test.mjs",
    "test:device-auth": "node --conditions react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/auth/device-auth-bridge.test.mjs",
    "auth:turso:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --experimental-strip-types scripts/auth/setup-turso-identity.ts",
    "auth:turso:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --experimental-strip-types scripts/auth/import-legacy-profiles-to-turso.ts",
    "auth:clerk:backfill-usernames": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --experimental-strip-types scripts/auth/backfill-clerk-usernames.ts",
    "leaks:ingest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --experimental-strip-types scripts/ingest-leak.ts",
    "fc27:download": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/fc27/download-ea-ratings.ts",
    "fc27:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --experimental-strip-types scripts/fc27/sync-fc27-players.ts",
    "fc27:generate-public-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/fc27/generate-public-data.ts",
    "fc27:data-integrity": "node --test scripts/fc27/data-integrity.test.mjs",
    "test:analytics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/analytics/*.test.mjs",
    "test:fc27-static-data": "node --conditions react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/fc27/static-data.test.mjs",
    "test:fc27-players": "node --conditions react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/fc27/players.test.mjs",
    "analytics:d1:migrate:local": "wrangler d1 migrations apply ANALYTICS_DB --local",
    "analytics:d1:migrate:remote": "wrangler d1 migrations apply ANALYTICS_DB --remote"
  },
  "dependencies": {
    "@clerk/localizations": "^4.15.6",
    "@clerk/nextjs": "^7.8.0",
    "@libsql/client": "^0.17.4",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.126.0"
  }
}

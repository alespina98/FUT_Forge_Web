{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fut-forge-web",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare's edge checks its cache before invoking this Worker on every
  // request; a HIT is served with zero Worker CPU. Only safe because every
  // GET response this Worker can return now carries an explicit
  // Cache-Control (audited 2026-09-21: see git log for the full route-by-
  // route classification) - public/cacheable for /fc27/players, /fc27/clubs
  // and /fc27/compare only, private/no-store everywhere else, including
  // every API route. Do not flip this back on casually if that invariant
  // ever regresses - an unprotected personal GET becomes cross-user
  // cacheable the moment this is true.
  "cache": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fut-forge-web"
    }
  ],
  // Analytics storage (see d1/migrations/).
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "futforge-analytics",
      "database_id": "d69aabb8-904e-4073-b6de-4638f376a6b8",
      "migrations_dir": "d1/migrations"
    }
  ],
  // Fixed-window rate-limit counters for POST /api/analytics/events only.
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_RATE_LIMIT",
      "id": "228af9c9781c42eab4c1d6456a38f03e"
    }
  ]
}

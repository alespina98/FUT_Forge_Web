{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fut-forge-web",
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fut-forge-web"
    }
  ],
  // Analytics storage (see d1/migrations/). database_id is a placeholder -
  // run `wrangler d1 create futforge-analytics` and replace it with the
  // real id before deploying. Local dev/preview work with the placeholder
  // as-is (wrangler's --local/preview D1 emulation doesn't call the API).
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "futforge-analytics",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "d1/migrations"
    }
  ],
  // Fixed-window rate-limit counters for POST /api/analytics/events only.
  // Run `wrangler kv namespace create ANALYTICS_RATE_LIMIT` and replace the
  // placeholder id before deploying.
  "kv_namespaces": [
    {
      "binding": "ANALYTICS_RATE_LIMIT",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
